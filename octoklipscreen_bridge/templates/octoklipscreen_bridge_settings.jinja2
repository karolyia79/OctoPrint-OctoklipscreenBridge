<div id="settings_plugin_octoklipscreenbridge">
    <h3>Octoklipscreen Bridge Beállítások</h3>

    {# Figyelmeztető doboz #}
    <div class="alert alert-error" style="background-color: #f2dede; border-color: #ebccd1; color: #a94442; padding: 15px; margin-bottom: 20px; border-radius: 4px;">
        <strong>⚠️ FIGYELEM! KÖTELEZŐ LÉPÉS!</strong><br>
        Ha ezt elfelejted bekapcsolni, a plugin süket marad:<br>
        Menj az OctoPrint <strong>Settings -> Features</strong> fülére, és pipáld be a <strong>Log communication to serial.log</strong> opciót! 🦆
    </div>

    <form class="form-horizontal">
        <div class="control-group">
            <label class="control-label" for="mqtt_broker">MQTT Broker IP</label>
            <div class="controls">
                <input type="text" id="mqtt_broker" data-bind="value: settings.plugins.octoklipscreenbridge.mqtt_broker">
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="mqtt_user">MQTT User</label>
            <div class="controls">
                <input type="text" id="mqtt_user" data-bind="value: settings.plugins.octoklipscreenbridge.mqtt_user">
            </div>
        </div>
        <div class="control-group">
            <label class="control-label" for="octoklipscreen_mqtt_pass">MQTT Password</label>
            <div class="controls">
                <input type="password" id="octoklipscreen_mqtt_pass" data-bind="value: settings.plugins.octoklipscreenbridge.mqtt_pass">
                <label class="checkbox" style="display: inline-block; margin-left: 10px;">
                    <input type="checkbox" id="show_password_checkbox" 
                           onclick="document.getElementById('octoklipscreen_mqtt_pass').type = this.checked ? 'text' : 'password';"> 
                    Jelszó mutatása
                </label>
            </div>
        </div>
    </form>
</div>
